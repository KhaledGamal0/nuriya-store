# Copy to .env.local for local development. Never commit real values.
# Neon POOLED connection string (Vercel and the running site). Leave empty to use the built-in product data.
DATABASE_URL=
# Any long random string. Protects POST /api/revalidate (refresh pages after editing the database).
REVALIDATE_SECRET=
# Public site address, used for SEO links.
NEXT_PUBLIC_SITE_URL=https://nuriya-store.vercel.app
# Order e-mail to the shop (Resend). Without these, orders are still saved; the hourly Order watch alerts you.
RESEND_API_KEY=
ORDER_ALERT_EMAIL=
# Optional sender once a domain is verified in Resend, e.g. "Nuriya orders <orders@nuriya.eg>".
ORDER_EMAIL_FROM=
# "1" only after Paymob is connected (Phase 4). Until then card payment is hidden and refused.
PAYMOB_ENABLED=
# Optional salt for hashing buyer IPs (defaults to REVALIDATE_SECRET).
IP_HASH_SALT=
